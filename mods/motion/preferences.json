      {
        "not": {
          "property": "zenith.motion.preset",
          "value": "off"
        }
      }
    ],
    "operator": "AND",
    "zenithWhy": "Motion is off"
  },
  {
    "property": "zenith.motion.swipe",
    "label": "Swipe back/forward animation",
    "type": "dropdown",
