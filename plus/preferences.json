[
  {
    "property": "zenith.peek.enabled",
    "label": "Peek: Alt+Q, or Shift+Enter in the URL bar (type ? in Peek to edit prefixes)",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus"
  },
  {
    "property": "zenith.peek.engine",
    "label": "Peek search engine",
    "type": "dropdown",
    "placeholder": "Default (Google)",
    "options": [
      {
        "label": "Google",
        "value": "google"
      },
      {
        "label": "Google AI Mode",
        "value": "google-ai"
      },
      {
        "label": "Google, web results only",
        "value": "google-web"
      },
      {
        "label": "DuckDuckGo",
        "value": "duckduckgo"
      },
      {
        "label": "Kagi",
        "value": "kagi"
      },
      {
        "label": "Bing",
        "value": "bing"
      }
    ],
    "usedBy": "zenith-plus",
    "conditions": [
      {
        "if": {
          "property": "zenith.peek.enabled",
          "value": true
        }
      },
      {
        "if": {
          "property": "zenith.peek.custom-engine",
          "value": ""
        }
      }
    ],
    "operator": "AND",
    "zenithWhy": "Peek is off, or your custom search URL is used instead"
  },
  {
    "property": "zenith.peek.custom-engine",
    "label": "Peek custom search URL, used instead of the engine",
    "type": "string",
    "placeholder": "https://example.com/search?q=%s",
    "usedBy": "zenith-plus",
    "conditions": [
      {
        "if": {
          "property": "zenith.peek.enabled",
          "value": true
        }
      }
    ],
    "operator": "AND",
    "zenithWhy": "Peek is off"
  },
  {
    "property": "zenith.peek.instant",
    "label": "Peek instant answers: maths, units and time zones",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus",
    "conditions": [
      {
        "if": {
          "property": "zenith.peek.enabled",
          "value": true
        }
      }
    ],
    "operator": "AND",
    "zenithWhy": "Peek is off"
  },
  {
    "property": "zenith.peek.web-cards",
    "label": "Peek answers from the web: currency ($), definitions (d), weather (wt)",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus",
    "conditions": [
      {
        "if": {
          "property": "zenith.peek.enabled",
          "value": true
        }
      }
    ],
    "operator": "AND",
    "zenithWhy": "Peek is off"
  },
  {
    "property": "zenith.peek.units",
    "label": "Peek weather units",
    "type": "dropdown",
    "placeholder": "Default (Automatic (from your country))",
    "options": [
      {
        "label": "Automatic (from your country)",
        "value": "auto"
      },
      {
        "label": "Metric: °C, km/h",
        "value": "metric"
      },
      {
        "label": "Imperial: °F, mph",
        "value": "imperial"
      }
    ],
    "usedBy": "zenith-plus",
    "conditions": [
      {
        "if": {
          "property": "zenith.peek.enabled",
          "value": true
        }
      },
      {
        "if": {
          "property": "zenith.peek.web-cards",
          "value": true
        }
      }
    ],
    "operator": "AND",
    "zenithWhy": "Peek or its answers from the web are off"
  },
  {
    "property": "zenith.peek.pomodoro",
    "label": "Peek pomodoro (type pomo)",
    "type": "dropdown",
    "placeholder": "Default (25 min focus, 5 min break, 4 rounds)",
    "options": [
      {
        "label": "25 min focus, 5 min break, 4 rounds",
        "value": "25-5-4"
      },
      {
        "label": "50 min focus, 10 min break, 3 rounds",
        "value": "50-10-3"
      },
      {
        "label": "15 min focus, 3 min break, 4 rounds",
        "value": "15-3-4"
      }
    ],
    "usedBy": "zenith-plus",
    "conditions": [
      {
        "if": {
          "property": "zenith.peek.enabled",
          "value": true
        }
      }
    ],
    "operator": "AND",
    "zenithWhy": "Peek is off"
  },
  {
    "property": "zenith.plus.minimap",
    "label": "Sidebar minimap while the sidebar is hidden",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus"
  },
  {
    "property": "zenith.plus.zoom-pill",
    "label": "Zoom pill on zoomed pages",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus"
  },
  {
    "property": "zenith.plus.media-art",
    "label": "Cover art of what's playing behind the media card",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus"
  },
  {
    "property": "zenith.plus.animate-zen",
    "label": "Let Zen and Zenith animate even when the system asks for less motion",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus"
  },
  {
    "property": "zenith.page.selection",
    "label": "Text selection in web pages in the workspace colour",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus"
  },
  {
    "property": "zenith.page.thin-scrollbars",
    "label": "Thin scrollbars in web pages in the workspace colour",
    "type": "checkbox",
    "defaultValue": false,
    "usedBy": "zenith-plus"
  },
  {
    "property": "zenith.plus.sine-mods-first",
    "label": "Sine's mods page: your mods first, marketplace folded away",
    "type": "checkbox",
    "defaultValue": true,
    "usedBy": "zenith-plus"
  }
]
